{
  "name": "@antelopejs/interface-api-util",
  "version": "0.3.0",
  "description": "AntelopeJS helpers for API handlers: request assertions, input validation and rate limiting",
  "keywords": [
    "antelopejs",
    "api",
    "interface",
    "rate-limit",
    "validation"
  ],
  "homepage": "https://interfaces.antelopejs.com/docs/api-util",
  "bugs": {
    "url": "https://github.com/AntelopeJS/interface-api-util/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/interface-api-util.git"
  },
  "files": [
    "dist",
    "docs",
    "skills"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "format": "oxfmt .",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run prepack && release-it",
    "test": "pnpm run build && ajs module test .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "ratchet": "antelopejs-ratchet",
    "sync": "antelopejs-sync",
    "ratchet:update": "antelopejs-ratchet --update",
    "sync:check": "antelopejs-sync --check",
    "typecheck": "tsc --noEmit",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "devDependencies": {
    "@antelopejs/core": "^1.16.0",
    "@antelopejs/interface-api": "file:.campaign/tgz/antelopejs-interface-api-71528ee.tgz",
    "@antelopejs/interface-core": "^0.2.4",
    "@antelopejs/tooling-configs": "^0.2.17",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "eslint-plugin-perfectionist": "^5.11.0",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@antelopejs/interface-api": ">=0.0.15 <1.0.0",
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0"
  },
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "overrides": {
      "@antelopejs/interface-api": "file:.campaign/tgz/antelopejs-interface-api-71528ee.tgz"
    }
  },
  "antelopeJs": {
    "test": "src/antelope.test.ts",
    "skills": [
      "./skills"
    ]
  }
}
